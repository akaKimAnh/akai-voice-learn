{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profile with streak stats and activity",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "streakCount": { "type": "number" },
        "lastActiveDate": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "vocabulary": {
      "title": "Vocabulary Word",
      "description": "Saved vocabulary word in user vault",
      "type": "object",
      "properties": {
        "word": { "type": "string" },
        "ipa": { "type": "string" },
        "meaning": { "type": "string" },
        "partOfSpeech": { "type": "string" },
        "example": { "type": "string" },
        "createdAt": { "type": "string" },
        "masteryLevel": { "type": "number" }
      },
      "required": ["word", "meaning"]
    },
    "sessions": {
      "title": "Voice Chat Session",
      "description": "Practice or job interview session",
      "type": "object",
      "properties": {
        "topic": { "type": "string" },
        "customJD": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["topic"]
    },
    "messages": {
      "title": "Session Message",
      "description": "Individual message in session",
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "text": { "type": "string" },
        "audioUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["role", "text"]
    },
    "streaks": {
      "title": "Streak History",
      "description": "Daily check-in history",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "checkedIn": { "type": "boolean" },
        "timestamp": { "type": "string" }
      },
      "required": ["date", "checkedIn"]
    }
  }
}
